[
  { "waitFor": "[data-testid=qualify]" },
  { "eval": "document.querySelector('[data-testid=qualify]').click(), 'q'" },
  { "waitFor": "[data-testid=to-race]" },
  { "eval": "document.querySelector('[data-testid=to-race]').click(), 'r'" },
  { "waitFor": "[data-testid=minimap]" },
  { "wait": 3000 },
  { "eval": "(() => { const c = document.querySelector('canvas'); for (let i = 0; i < 14; i++) c.dispatchEvent(new WheelEvent('wheel', {deltaY: -100, bubbles: true, cancelable: true})); return 'zoom on grid'; })()" },
  { "wait": 2000 },
  { "shot": "m9-grid.png" },
  { "eval": "(() => { const c = document.querySelector('canvas'); for (let i = 0; i < 14; i++) c.dispatchEvent(new WheelEvent('wheel', {deltaY: 100, bubbles: true, cancelable: true})); return 'zoom out'; })()" },
  { "eval": "document.querySelector('[data-testid=run]').click(), 'lights'" },
  { "wait": 5500 },
  { "eval": "document.querySelector('[data-camera=chase]').click(), 'chase'" },
  { "wait": 2500 },
  { "shot": "m9-chase.png" },
  { "eval": "document.querySelector('[data-camera=tv]').click(), 'tv'" },
  { "wait": 2500 },
  { "shot": "m9-tv.png" },
  { "eval": "'minimap dots ' + document.querySelectorAll('[data-testid=minimap] circle').length" },
  { "eval": "document.querySelector('[data-camera=overview]').click(), 'overview'" },
  { "wait": 1500 },
  { "shot": "m9-overview.png" }
