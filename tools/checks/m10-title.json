[
  {
    "waitFor": "[data-testid=title]"
  },
  {
    "wait": 800
  },
  {
    "shot": "m10-title-new.png"
  },
  {
    "eval": "'continue shown: ' + !!document.querySelector('[data-testid=continue-career]')"
  },
  {
    "eval": "document.querySelector('[data-testid=new-career]').click(), 'start career'"
  },
  {
    "waitFor": "[data-testid=qualify]"
  },
  {
    "eval": "document.querySelector('[data-practice=\"zetrace-0-tyres\"]').click(), document.querySelector('[data-practice=\"zetrace-1-fuel\"]').click(), 'practice set'"
  },
  {
    "wait": 300
  },
  {
    "shot": "m10-preview.png"
  },
  {
    "eval": "document.querySelector('[data-testid=qualify]').click(), 'q'"
  },
  {
    "waitFor": "[data-testid=to-race]"
  },
  {
    "eval": "document.querySelector('[data-testid=to-race]').click(), 'r'"
  },
  {
    "waitFor": "[data-testid=run]"
  },
  {
    "eval": "'practice in race: ' + window.__zetraceRace.cars.filter(c => c.isPlayer).map(c => c.id + '=' + c.practice).join(',')"
  },
  {
    "eval": "document.querySelector('[data-testid=run]').click(), 'lights'"
  },
  {
    "waitFor": "[data-testid=team-orders]"
  },
  {
    "eval": "document.querySelector('[data-order=hold]').click(), 'hold'"
  },
  {
    "wait": 600
  },
  {
    "eval": "'orders: ' + JSON.stringify(window.__zetraceRace.teamOrders)"
  },
  {
    "shot": "m10-orders.png"
  },
  {
    "eval": "location.reload(), 'reload'"
  },
  {
    "wait": 1500
  },
  {
    "waitFor": "[data-testid=continue-career]",
    "timeout": 60000
  },
  {
    "eval": "'continue label: ' + document.querySelector('[data-testid=continue-career]').innerText.split(String.fromCharCode(10)).join(' ')"
  },
  {
    "eval": "document.querySelector('[data-testid=continue-career]').click(), 'continue'"
  },
  {
    "waitFor": "[data-testid=to-race]",
    "timeout": 60000
  },
  {
    "eval": "'resumed on the grid'"
  }
