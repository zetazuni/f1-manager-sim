[
  { "waitFor": "[data-testid=qualify]" },
  { "eval": "document.querySelector('[data-testid=qualify]').click(), 'q'" },
  { "waitFor": "[data-testid=to-race]" },
  { "eval": "document.querySelector('[data-testid=to-race]').click(), 'r'" },
  { "waitFor": "[data-testid=run]" },
  { "eval": "document.querySelector('[data-testid=run]').click(), document.querySelector('[data-speed=\"4\"]').click(), 'go'" },
  { "waitFor": "[data-testid=modal-continue]", "timeout": 150000 },
  { "eval": "document.querySelector('[data-testid=modal-continue]').click(), 'continue'" },
  { "waitFor": "[data-testid=next-round]" },
  { "eval": "document.querySelector('[data-testid=next-round]').click(), 'finale'" },
  { "waitFor": "[data-testid=new-season]" },
  { "shot": "m8-finale.png" },
  { "eval": "document.querySelector('[data-testid=new-season]').click(), 'market'" },
  { "waitFor": "[data-testid=offseason]" },
  { "eval": "'market rows ' + document.querySelectorAll('[data-testid=market] tbody tr').length + ' budget ' + document.querySelector('[data-testid=market-budget]').textContent" },
  { "eval": "(() => { const b = [...document.querySelectorAll('[data-sign]')].find(x => !x.disabled && x.dataset.sign.endsWith('-1')); b.click(); return 'sign ' + b.dataset.sign; })()" },
  { "wait": 300 },
  { "eval": "'msg: ' + document.querySelector('[data-testid=market-msg]').textContent" },
  { "shot": "m8-market.png" },
  { "eval": "document.querySelector('[data-testid=start-next-season]').click(), 'start'" },
  { "waitFor": "[data-testid=qualify]" },
  { "eval": "'header: ' + document.querySelector('header').innerText.split(String.fromCharCode(10)).join(' ').slice(-60) + ' | plan: ' + [...document.querySelectorAll('[data-quali]')].map(b => b.closest('div.rounded-lg').querySelector('p').textContent).filter((v, i, a) => a.indexOf(v) === i).join(', ')" }
]
